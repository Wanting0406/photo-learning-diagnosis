{
  "id": "student_homework_image_recognition_1",
  "pluginKey": "@official-plugins/ai-image-understanding",
  "pluginVersion": "1.0.22",
  "name": "学情图片识别",
  "description": "使用平台图片理解能力识别学生作业或试卷照片，提示词由调用方传入，支持一次传入 1-6 张图片，输出可解析的文本。",
  "icon": "https://lf3-static.bytednsdoc.com/obj/eden-cn/fzgeh7nuhfboznulog/ai_image_understand.svg",
  "paramsSchema": {
    "type": "object",
    "properties": {
      "images": {
        "type": "array",
        "format": "plugin-image-url",
        "description": "待识别的学生作业/试卷图片，支持1-6张（http(s) 地址）",
        "items": {
          "type": "string"
        }
      },
      "prompt": {
        "type": "string",
        "description": "完整的识别提示词（含系统规则、上下文与输出 JSON 结构要求）"
      }
    },
    "required": [
      "images",
      "prompt"
    ]
  },
  "formValue": {
    "images": "{{input.images}}",
    "modelID": "2015",
    "modelParams": {
      "maxTokens": 8192,
      "temperature": 0.2
    },
    "prompt": "{{input.prompt}}"
  },
  "createdAt": 1795401356563,
  "updatedAt": 1795411037240,
  "createdBy": 0
}